PORT=3000
# Use local Postgres (run: docker compose up -d) or your Supabase URL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/group_loan
# Set to true to force local DB when remote host fails to resolve (ENOTFOUND)
USE_LOCAL_DB=false
JWT_SECRET=replace-with-strong-secret
JWT_EXPIRES_IN=7d
DB_LOGGING=false
# Optional: NIN lookup API (if not set, stub data is used for KYC step 0)
# NIN_API_URL=
# NIN_API_KEY=

# Optional: SMTP for sending emails (if not set, email send is no-op)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=noreply@yourapp.com
# APP_NAME=Enlace Group Loan