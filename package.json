    "migrate": "bun run src/migrate.ts",
    "migrate:undo": "bun run src/migrate-undo.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.3.1",
    "hono": "^4.12.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.18.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "umzug": "^3.8.2",
    "zod": "^4.3.6",
    "zeptomail": "^7.0.2",
    "@hono/node-server": "^1.19.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.3.0",
    "bun-types": "^1.3.9",
    "typescript": "^5.9.3"
  }
